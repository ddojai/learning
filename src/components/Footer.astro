---
import { GITHUB_URL } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} <a href={GITHUB_URL} target="_blank">ddojai</a>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer a {
		color: rgb(var(--gray));
	}
</style>
